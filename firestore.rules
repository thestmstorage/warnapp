rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    // Nur Cloud Functions (Admin SDK) schreiben. Clients duerfen nichts schreiben.
    match /warnings/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /devices/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /auditLog/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /rateLimits/{id} { allow read, write: if false; }
    match /{document=**}  { allow read, write: if false; }
  }
}
